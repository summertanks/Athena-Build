#!/bin/sh
# Athena pre-pkgsel hook — copy the operator-defined tasksel `.desc`
# from the cdrom into /target so `tasksel` finds it when pkgsel runs
# `in-target tasksel --new-install` during d-i's "Software selection"
# step.
#
# The `.desc` is generated at iso-build time by
# `iso_installer._stage_tasksel_desc` and ships at
# `<cdrom>/.disk/athena-tasks.desc` on the installer ISO.  See
# `docs/plans/comp-02-robust-build.md` and GROUPS-01 in TODO.md for
# the broader context.
#
# Installed into the initrd at `/usr/lib/pre-pkgsel.d/05-athena-tasks`
# via `installer_chroot._OVERLAY_MAP`.  pkgsel runs all scripts under
# `/usr/lib/pre-pkgsel.d/` (via run-parts) right before invoking
# tasksel, so this hook is the right insertion point.
#
# THREE-LAYER cdrom resolution — earlier attempts (commits 2cd13b6,
# d9818b0) tried just one layer at a time and silently failed.  Real
# d-i state at hook time is more variable than any single fixed
# mount path can capture:
#
#   Layer 1 — static paths.  Works for vanilla CD installs where
#     cdrom-detect's mount survives apt-setup.
#
#   Layer 2 — /proc/mounts scan for any iso9660/udf filesystem.
#     Catches non-standard mount points (e.g. /var/lib/cdrom on
#     some d-i variants).
#
#   Layer 3 — mount the cdrom device ourselves.  apt-cdrom uses
#     mount-on-demand: it mounts when fetching a .deb, unmounts
#     immediately after.  Between fetches there's NO persistent
#     mount to find, so layers 1+2 turn up empty even though the
#     cdrom is physically present and (per apt's `cdrom://` URL)
#     accessible.  This is the layer that actually unblocked our
#     install on the third try (2026-05-15).
#
# On total miss, dumps /proc/mounts state via syslog for
# next-cycle diagnosis — no need to add debug instrumentation
# and rebuild a multi-hour installer ISO.
#
# Exits 0 even when the .desc is absent (e.g. operator did not
# declare any non-[base] groups) so a hookless build still
# installs cleanly.

set -e

# Destination — d-i installs `tasksel-data` into /target/, and tasksel
# reads ALL `.desc` files in /usr/share/tasksel/descs/ at runtime.
_DST_DIR="${ATHENA_TASKS_DST_DIR:-/target/usr/share/tasksel/descs}"
_DST="$_DST_DIR/athena.desc"

# Source — explicit override wins (smoke tests in tests/test_module.py
# drive the hook against a tempdir).  Otherwise probe.
_SRC="${ATHENA_TASKS_SRC:-}"

_TMPMNT=""
cleanup() {
    if [ -n "$_TMPMNT" ]; then
        umount "$_TMPMNT" 2>/dev/null || true
        rmdir "$_TMPMNT" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# Layer 1 — static paths.
if [ -z "$_SRC" ]; then
    for _candidate in \
        /cdrom/.disk/athena-tasks.desc \
        /media/cdrom/.disk/athena-tasks.desc \
        /media/cdrom0/.disk/athena-tasks.desc \
        /target/media/cdrom/.disk/athena-tasks.desc \
        /target/media/cdrom0/.disk/athena-tasks.desc
    do
        if [ -f "$_candidate" ]; then
            _SRC="$_candidate"
            break
        fi
    done
fi

# Layer 2 — /proc/mounts scan for any iso9660/udf mount.
if [ -z "$_SRC" ] && [ -r /proc/mounts ]; then
    while IFS= read -r _line; do
        # /proc/mounts format: device mountpoint fstype options dump pass
        # POSIX-shell positional split on whitespace via `set --`.
        set -- $_line
        _mp="$2"
        _fs="$3"
        case "$_fs" in
            iso9660|udf)
                if [ -f "$_mp/.disk/athena-tasks.desc" ]; then
                    _SRC="$_mp/.disk/athena-tasks.desc"
                    break
                fi
                ;;
        esac
    done < /proc/mounts
fi

# Layer 3 — mount the cdrom device ourselves.
# apt-cdrom mount-on-demand behaviour means the cdrom is unmounted
# between apt fetches; we need to mount it ourselves to read .disk/.
if [ -z "$_SRC" ]; then
    _DEV=""
    # Prefer cdrom-detect's recorded device.
    if [ -r /usr/share/debconf/confmodule ]; then
        # debconf may already be sourced by pkgsel's parent — be
        # defensive about exit codes since the protocol is over
        # stdin/stdout pipes inherited from the caller.
        # shellcheck disable=SC1091
        . /usr/share/debconf/confmodule 2>/dev/null || true
        db_get cdrom-detect/cdrom_device 2>/dev/null && _DEV="$RET" || true
    fi
    # Fallback to common device names (covers cases where debconf
    # isn't reachable — e.g. test runs, or a stripped d-i variant).
    if [ -z "$_DEV" ]; then
        for _d in /dev/sr0 /dev/cdrom /dev/sr1 /dev/cdrom0; do
            if [ -e "$_d" ]; then
                _DEV="$_d"
                break
            fi
        done
    fi

    if [ -n "$_DEV" ]; then
        _TMPMNT=$(mktemp -d 2>/dev/null || echo "/tmp/athena-cdrom-$$")
        mkdir -p "$_TMPMNT"
        if mount -t iso9660 -o ro "$_DEV" "$_TMPMNT" 2>/dev/null; then
            if [ -f "$_TMPMNT/.disk/athena-tasks.desc" ]; then
                _SRC="$_TMPMNT/.disk/athena-tasks.desc"
            fi
        fi
    fi
fi

if [ -z "$_SRC" ] || [ ! -f "$_SRC" ]; then
    logger -t athena-pre-pkgsel "no .desc found anywhere — skipping"
    # Diagnostic: dump /proc/mounts iso/udf entries so a future regression
    # is debuggable without instrumenting the hook and re-cycling the ISO.
    if [ -r /proc/mounts ]; then
        _iso_mounts=$(grep -E ' (iso9660|udf) ' /proc/mounts || true)
        if [ -z "$_iso_mounts" ]; then
            logger -t athena-pre-pkgsel "  /proc/mounts has no iso9660/udf entries"
        else
            echo "$_iso_mounts" | while IFS= read -r _m; do
                logger -t athena-pre-pkgsel "  /proc/mounts: $_m"
            done
        fi
    fi
    if [ -e /dev/sr0 ]; then
        logger -t athena-pre-pkgsel "  /dev/sr0 exists ($(stat -c '%s bytes, %A' /dev/sr0 2>/dev/null || echo '?'))"
    else
        logger -t athena-pre-pkgsel "  /dev/sr0 does not exist"
    fi
    exit 0
fi

# `$_DST_DIR` ships in the `tasksel` package which pkg.list `[base]`
# debootstraps onto every install.  mkdir -p covers the corner case
# where a stripped build skipped tasksel.
mkdir -p "$_DST_DIR"
cp "$_SRC" "$_DST"
logger -t athena-pre-pkgsel "installed $_DST (from $_SRC)"
