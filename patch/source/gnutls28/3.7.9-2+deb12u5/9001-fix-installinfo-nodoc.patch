Description: Guard info post-processing sed against nodoc in override_dh_installinfo
 With nodoc in DEB_BUILD_OPTIONS, dh_installinfo does not install info files
 so debian/gnutls-doc/usr/share/info/ is absent or empty. The subsequent
 cd+sed then fails because *.info* matches nothing. Keep dh_installinfo so
 dh_missing accounts for the skipped files, but guard only the sed step.
Author: Harkirat S Virk <harkiratsvirk@gmail.com>
Origin: local
Forwarded: no
Last-Update: 2026-05-03
---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/debian/rules
+++ b/debian/rules
@@ -102,10 +102,12 @@
 
 override_dh_installinfo:
 	dh_installinfo $(BDIR)
+ifeq (,$(filter nodoc,$(DEB_BUILD_OPTIONS)))
 	if test -e debian/gnutls-doc ; then \
 		cd debian/gnutls-doc/usr/share/info && \
 		sed -i -e 's:image src="\([^"]*.png"\):image src="/usr/share/doc/gnutls-doc/html/\1:g' *.info* ; \
 	fi
+endif
 
 override_dh_installchangelogs:
 	dh_installchangelogs $(BDIR)
