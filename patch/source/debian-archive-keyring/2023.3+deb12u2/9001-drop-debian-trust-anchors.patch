---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/debian/debian-archive-keyring.install
+++ b/debian/debian-archive-keyring.install
@@ -1,2 +1 @@
 usr/share/keyrings/*
-etc/apt/trusted.gpg.d/*
