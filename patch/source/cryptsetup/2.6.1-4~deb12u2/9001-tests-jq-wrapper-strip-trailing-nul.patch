Description: tests: wrap jq to strip trailing NUL padding from LUKS2 JSON areas
 The luks2-validation-test generators feed the raw 12 KiB JSON area
 (JSON object + NUL padding) straight to jq.  jq 1.6-2.1+deb12u2 (the
 bookworm point-release update carrying the fix for CVE-2026-33948,
 "jq no longer handling 0x00 characters") now parses the trailing NUL
 run as a spurious second input value `0`, so filters like
 `.keyslots."0"...` die with 'Cannot index number with string
 "keyslots"' and the generators abort (test FAIL, exit 5).
 .
 Backport of upstream commits
   fe0afb9046 ("ci: Replace jq with bash wrapper")
   6298269486 ("ci: Fix jq no longer handling 0x00 characters")
 squashed and rebased onto 2.6.1: add a _jq() wrapper in
 tests/generators/lib.sh that strips trailing 0x00 bytes before piping
 to `jq -c`, and switch every generator to it.
Origin: backport, https://gitlab.com/cryptsetup/cryptsetup/-/commit/fe0afb9046
Origin: backport, https://gitlab.com/cryptsetup/cryptsetup/-/commit/6298269486
Bug: https://gitlab.com/cryptsetup/cryptsetup/-/issues/989
diff -Nru a/tests/generators/generate-luks2-area-in-json-hdr-space-json0.img.sh b/tests/generators/generate-luks2-area-in-json-hdr-space-json0.img.sh
--- a/tests/generators/generate-luks2-area-in-json-hdr-space-json0.img.sh	2023-02-09 11:12:17.000000000 -0500
+++ b/tests/generators/generate-luks2-area-in-json-hdr-space-json0.img.sh	2026-07-06 01:08:01.865480208 -0400
@@ -19,7 +19,7 @@
 	# make area 7 access the luks2 header space
 	OFFS=$((2*LUKS2_HDR_SIZE*512-1))
 	LEN=1
-	json_str=$(jq -c --arg off $OFFS --arg len $LEN \
+	json_str=$(_jq --arg off $OFFS --arg len $LEN \
 		   '.keyslots."0".area.offset = $off | .keyslots."0".area.size = $len' $TMPDIR/json0)
 	test ${#json_str} -lt $((LUKS2_JSON_SIZE*512)) || exit 2
 
@@ -33,7 +33,7 @@
 	lib_hdr1_killed || exit 2
 
 	read_luks2_json0 $TGT_IMG $TMPDIR/json_res0
-	jq -c --arg off $OFFS --arg len $LEN \
+	_jq --arg off $OFFS --arg len $LEN \
 	    'if (.keyslots."0".area.offset != $off) or (.keyslots."0".area.size != $len)
 	       then error("Unexpected value in result json") else empty end' $TMPDIR/json_res0 || exit 5
 }
