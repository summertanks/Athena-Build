#. Description
#: ../po/debian-tasks.desc:2001
msgid "Development tools"
msgstr ""

#. Description
#: ../po/debian-tasks.desc:2001
msgid ""
"Compiler toolchain, version control, editors, and runtime diagnostic helpers "
"for software development on Athena.  Mirrors the content of config/pkg.list "
"[development-tools] — keep in sync when adding/removing packages."
msgstr ""

#. Description
#: ../po/debian-tasks.desc:3001
#, fuzzy
#| msgid "GNOME desktop environment"
msgid "GNOME Desktop Environment"
msgstr "Gnome ئۈستەلئۈستى مۇھىتى"

#. Description
#: ../po/debian-tasks.desc:3001
msgid ""
"Athena's GNOME desktop — shell, file manager, terminal, system settings, "
"browser, common GNOME apps + utilities, PIM stack (calendar/contacts/"
"clocks), software center, and admin GUI tools."
msgstr ""

#. Description
#: ../po/debian-tasks.desc:3001
msgid ""
"Derived from Debian's gnome-desktop task content (gnome-core + gnome meta) "
"merged with Athena-specific additions (firefox-esr as default browser, gnome-"
"screenshot, Noto+DejaVu fonts). Mirrors the content of config/pkg.list "
"[gnome-desktop] — keep in sync when adding/removing packages."
msgstr ""

#. Description
#: ../po/debian-tasks.desc:6001
msgid "standard system utilities"
msgstr "ئۆلچەملىك سىستېما قوراللىرى"

#. Description
#: ../po/debian-tasks.desc:6001
msgid ""
"A curated set of command-line utilities that Athena installs by default.  "
"Derivative of Debian's \"standard\" task but uses an explicit Key: list "
"(Athena-chosen) rather than the broad \"Packages: standard\" Priority "
"sigil.  Operator who wants any Debian-standard package not listed here can "
"apt-install individually post-install — they're all available in /cdrom/pool."
msgstr ""

#~ msgid ""
#~ "This task sets up a basic user environment, providing a reasonably small "
#~ "selection of services and tools usable on the command line."
#~ msgstr ""
#~ "بۇ ۋەزىپە ئاساسىي ئىشلەتكۈچى مۇھىتىدىن بىرنى تەڭشەيدۇ، ئۆزى مۇۋاپىق ئەمما "
#~ "كىچىك بولغان بۇيرۇق قۇرىدا ئىشلەتكىلى بولىدىغان مۇلازىمېتىر ۋە قورالنى "
#~ "تاللاش بىلەن تەمىنلەيدۇ."

#~ msgid "SQL database"
#~ msgstr "SQL ساندان"

#~ msgid ""
#~ "This task selects client and server packages for the PostgreSQL database."
#~ msgstr "بۇ ۋەزىپە PostgreSQL سانداننىڭ خېرىدار ۋە مۇلازىمېتىرىنى تاللايدۇ."

#~ msgid ""
#~ "PostgreSQL is an SQL relational database, offering increasing SQL92 "
#~ "compliance and some SQL3 features.  It is suitable for use with multi-"
#~ "user database access, through its facilities for transactions and fine-"
#~ "grained locking."
#~ msgstr ""
#~ "PostgreSQL بىر خىل SQL مۇناسىۋەت ساندىنى بولۇپ، SQL92 ئۆلچىمىگە بويسۇنىدۇ "
#~ "ھەمدە SQL3 ئالاھىدىلىكىنى تەمىنلەيدۇ. ئۇ قۇلاي بولغان ئىش بىر تەرەپ قىلىش "
#~ "ۋە fine-grained قۇلۇپلاش ئىقتىدارى بار. شۇڭلاشقا كۆپ ئىشلەتكۈچىلەرنىڭ "
#~ "ئىشلىتىشىگە ماس كېلىدۇ."

#~ msgid "Graphical desktop environment"
#~ msgstr "گرافىكىلىق ئۈستەلئۈستى مۇھىتى"

#~ msgid ""
#~ "This task provides basic desktop software and serves as a basis for the "
#~ "GNOME and KDE desktop tasks."
#~ msgstr ""
#~ "بۇ ۋەزىپە GNOME ۋە KDE ئۈستەلئۈستى يۇمشاق دېتاللىرىنىڭ ئاساسى بولغان "
#~ "ئاساسىي ئۈستەلئۈستى يۇمشاق دېتالى ۋە مۇلازىمىتىنى تەمىنلەيدۇ."

#~ msgid "DNS server"
#~ msgstr "DNS مۇلازىمېتىرى"

#~ msgid ""
#~ "Selects the BIND DNS server, and related documentation and utility "
#~ "packages."
#~ msgstr ""
#~ "BIND DNS مۇلازىمېتىرى شۇنداقلا ئۇنىڭغا مۇناسىۋەتلىك پۈتۈك ۋە قورال "
#~ "بوغچىلىرىنى ئۆز ئىچىگە ئالىدۇ."

#~ msgid "File server"
#~ msgstr "ھۆججەت مۇلازىمېتىرى"

#~ msgid ""
#~ "This task sets up your system to be a file server, supporting both CIFS "
#~ "and NFS."
#~ msgstr ""
#~ "بۇ ۋەزىپە سىستېمىڭىزنى CIFS ۋە NFS نى قوللايدىغان ھۆججەت مۇلازىمېتىرى "
#~ "قىلىپ تەڭشەيدۇ."

#~ msgid ""
#~ "This task provides basic \"desktop\" software using the GNOME desktop "
#~ "environment."
#~ msgstr ""
#~ "بۇ ۋەزىپە GNOME ئۈستەلئۈستى مۇھىتى ئىشلىتىپ ئاساسىي ئۈستەلئۈستى يۇمشاق "
#~ "دېتالىنى تەمىنلەيدۇ."

#~ msgid "KDE desktop environment"
#~ msgstr "KDE ئۈستەلئۈستى مۇھىتى"

#~ msgid ""
#~ "This task provides basic \"desktop\" software using the K Desktop "
