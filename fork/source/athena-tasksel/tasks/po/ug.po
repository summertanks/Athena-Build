#~ msgid "manual package selection"
#~ msgstr "قولدا بوغچا تاللاش"

#~ msgid "Manually select packages to install in aptitude."
#~ msgstr "aptitude دا ئورنىتىدىغان بوغچىلارنى قولدا تاللاڭ."

#~ msgid "Print server"
