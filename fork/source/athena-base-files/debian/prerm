#!/bin/sh
# athena-base-files prerm — reverse what postinst + preinst set up
# so removing our package returns the system to upstream base-files
# identity files.

set -e

case "$1" in
    remove|deconfigure)
        # 1. Remove the files we cp'd into place in postinst (dpkg
        #    doesn't track them — they live in /etc/* and /usr/lib,
        #    but as far as the dpkg database is concerned our pkg
        #    only owns /usr/share/athena-base-files/*).
        for f in /etc/issue /etc/issue.net /etc/motd /usr/lib/os-release; do
            rm -f "$f"
        done
        # 2. Reverse the diversions registered by preinst.  --rename
        #    moves the *.upstream copies back to the canonical paths.
        for f in /etc/issue /etc/issue.net /etc/motd /usr/lib/os-release; do
            if dpkg-divert --listpackage "$f" 2>/dev/null \
                    | grep -q '^athena-base-files$'; then
                dpkg-divert --remove --rename \
                    --package athena-base-files \
                    --divert "${f}.upstream" \
                    "$f"
            fi
        done
        ;;
    upgrade)
        # Keep diversions + our /etc/* content in place; the new
        # version's preinst will see existing diverts (and skip
        # them via its listpackage guard) and postinst will refresh
        # the /etc/* content with any updated tokens.
        ;;
esac

#DEBHELPER#
exit 0
