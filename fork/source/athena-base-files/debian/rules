#!/usr/bin/make -f
# athena-base-files — diverts upstream base-files identity files and
# ships @DISTRIBUTION@-branded replacements.  No build step needed;
# pure file-shipping plus preinst/prerm divert dance.
#
# Token substitution for @DISTRIBUTION@ / @BASE_ID@ / @CODENAME@ in
# debian/, data/ content is performed centrally by BuildContainer's
# _token_subst snippet before dpkg-buildpackage runs.

%:
	dh $@
