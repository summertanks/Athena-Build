# Linux kernel
linux-image-amd64
# Kernel headers — needed only by DKMS / out-of-tree module compiles.
# Not required for a vanilla running system; kept for developer/admin
# convenience.
linux-headers-amd64
# Free firmware blobs the kernel recommends.  Covers BSD-licensed
# firmware for various NICs, GPUs, and storage controllers.  No
# non-free-firmware component needed.  For non-free firmware blobs
# (firmware-iwlwifi, firmware-misc-nonfree) or CPU microcode
# (intel-microcode, amd64-microcode), add 'non-free-firmware' to
# the [Mirror.*] Component lines in build.conf — separate work.
firmware-linux-free

# Bootloader
#
# COMP-02 phase C TODO: replace `grub-pc` with `grub-pc-bin` +
# `grub-efi-amd64-bin` (binaries, no conflict) and let grub-installer
# pick the meta-package at install time.  That requires fixing
# apt-cdrom-setup first so `apt-install grub-pc` actually works.
# See docs/plans/comp-02-robust-build.md.
#
# `grub-pc` is the BIOS-mode bootloader.  Pre-installing it here (so
# debootstrap pulls it into /target via --include base_include) makes
# grub-installer's `apt-install grub-pc` step succeed as "already the
# newest version" instead of failing on broken in-target apt sources.
# Without this, grub-installer exits 10, corrupts main-menu's debconf
# DB, and the installer enters a respawn loop (caught 2026-05-12 after
# extensive apt-cdrom-setup debugging).
#
# For EFI targets we'd want `grub-efi-amd64` instead — they Conflict,
# so only one meta-package can be in the pkg list.  When EFI support
# is on the roadmap, this becomes a build-config switch or the
# installer flow needs to decide post-detection.
grub-pc

