# pkg.list — INI-style.  Each `[group]` section is an install-time
# package group.  `[base]` is always installed (live image + target
# debootstrap); other groups ship in /cdrom/pool and the installer
# (tasksel) apt-installs the operator-selected subset on /target.
#
# Backward-compat: a flat pkg.list (no `[section]` markers) is parsed
# as a single implicit `[base]` group.

[base]
## Description: Athena base system — kernel, bootloader, init, shell.
# Linux kernel
linux-image-amd64
# Kernel headers — needed only by DKMS / out-of-tree module compiles.
# Not required for a vanilla running system; kept for developer/admin
# convenience.
linux-headers-amd64
# Free firmware blobs the kernel recommends.  Covers BSD-licensed
# firmware for various NICs, GPUs, and storage controllers.  No
# non-free-firmware component needed.  For non-free firmware blobs
# (firmware-iwlwifi, firmware-misc-nonfree) or CPU microcode
# (intel-microcode, amd64-microcode), add 'non-free-firmware' to
# the [Mirror.*] Component lines in build.conf — separate work.
firmware-linux-free

# Bootloader
#
# Ship the bin-only packages for both BIOS (`grub-pc-bin`) and EFI
# (`grub-efi-amd64-bin`) modes.  Unlike the full `grub-pc` /
# `grub-efi-amd64` meta-packages, the `-bin` packages do NOT Conflict,
# so both can coexist on the live/installer system and on /target.
#
# At install time, `grub-installer` detects the firmware mode (BIOS vs
# EFI) and runs `apt-install grub-pc` or `apt-install grub-efi-amd64`.
# The chosen meta-package Depends on its corresponding `-bin`, which
# is already present in /target (debootstrap pulled it in via
# .disk/base_include), so apt only has to install the small meta and
# its EFI/BIOS-specific glue.  No network fetch of grub itself.
#
# History: COMP-02 phase A pre-installed the full `grub-pc` here as a
# workaround for a broken apt-cdrom-setup chain — `grub-installer`'s
# `apt-install grub-pc` step would fail on the in-target apt sources,
# exit 10, corrupt main-menu's debconf DB, and trigger a respawn loop.
# Phase C (commit 42e03ea) fixed apt-cdrom-setup end-to-end by signing
# the Release file and installing the pubkey at /target before the
# apt-cdrom step runs, so the workaround is no longer needed.  Switching
# to bin-only also unblocks EFI installs (Phase D, this change).
grub-pc-bin
grub-efi-amd64-bin

# Essential Packages
base-files
base-passwd
libc6
zlib1g
init
adduser
apt
debian-archive-keyring
debconf
e2fsprogs
findutils
grep
gzip
kbd
locales
login
mount
ncurses-base
sed
tar
tzdata
udev
util-linux
gawk

# Init System
systemd-sysv
libsystemd0
libpam-systemd

bash
bsdutils
coreutils
debianutils
diffutils
dpkg
hostname
init-system-helpers
libc-bin
ncurses-bin
perl-base
sysvinit-utils

initramfs-tools

# Remote access
openssh-server

# required for login
dbus

# simplifying package selection
dialog

# d-i runtime apt-install dependencies — packages that base-installer,
# grub-installer, hw-detect, finish-install, etc. call `apt-install`
# on at install time.  Listing them explicitly here puts them in
# pkg_closure (Pass III) so they're definitely on the target AND not
# accidentally classified as `live_exclusive` (which happens when
# live.list's transitive deps happen to mention them first — caught
# 2026-05-12 with busybox).  See audit in conversation 2026-05-12
# (apt-install callsite walk through buildroot/installer/).

# FATAL apt-installs — d-i scripts abort if these aren't on target.
# busybox, zstd: base-installer/library.sh kernel install path
# grub-common, dmsetup: grub-installer
busybox
zstd
grub-common
dmsetup

# TOLERANT (|| true) but their absence shows up as warnings/cosmetic
# issues at finish-install or in main-menu.  Adding them silences
# `eject: not found`, `Falling back to package description for
# os-prober-udeb`, and the queued-but-no-source warnings from
# cdrom-detect / hw-detect for pciutils + usbutils.
eject
os-prober
pciutils
usbutils

# Filesystems other than ext4 — partman finish queues these via
# apt-install when the user picks the corresponding fs.  dosfstools is
# needed for the EFI System Partition (vfat); pre-installing means
# COMP-02 phase D (EFI support) doesn't need a separate add.
dosfstools

# sudo is already a Recommends of several packages so it'd come in
# via extras; explicit here so it's in base_include (the target's
# install set) — gives a usable default for `user-setup-apply` to wire
# up admin sudo without depending on apt-install succeeding mid-install.
sudo

# tasksel — the "Software selection" engine pkgsel calls during
# install.  Goes in [base] (debootstrapped onto every /target) so
# pkgsel's `in-target tasksel --new-install` works offline from
# /cdrom/pool without an apt-install step.
#
# FORK-01 Step 5+5b: athena-tasksel + athena-tasksel-data (both
# Provides + Conflicts + Replaces upstream tasksel/tasksel-data
# at version (= 3.73)) — Athena multi-binary fork from
# fork/source/athena-tasksel/.  Engine ignores DEBIAN_TASKS_ONLY;
# data ships /usr/share/tasksel/descs/athena-tasks.desc with our
# curated 6-task set (standard, ssh-server, laptop, desktop,
# gnome-desktop, development-tools).  athena-tasksel-data is pulled
# transitively by athena-tasksel's `Depends: tasksel-data` — no
# explicit listing needed.
athena-tasksel

# openssl CLI — runtime dep of `ca-certificates` (which is
# Priority:standard, so tasksel's "Standard system utilities" task
# tries to install it on every fresh /target).  `libssl3` alone
# isn't enough — ca-certificates.postinst calls `openssl` to verify
# CA bundle hashes.  We already build openssl from source for libssl3;
# adding it to [base] just whitelists the openssl binary .deb into
# the pool (and debootstraps the CLI onto /target).  Caught
# 2026-05-15 — without this, tasksel fails with
# `ca-certificates : Depends: openssl (>= 1.1.1) but it is not installable`
# and the whole Software-selection step bombs out.
openssl


[development-tools]
## Description: Compiler toolchain, version control, editors, and runtime diagnostics.
##
## FORK-01 Step 5b note: mirrors the Key: list in
## fork/source/athena-tasksel/tasks/development-tools.  Keep in
## sync when adding/removing packages (Path β workflow per
## docs/plans/fork-source.md).
build-essential
git
vim
less
htop
strace


[gnome-desktop]
## Description: GNOME desktop environment — Athena's curated GNOME suite, merged from Debian gnome-core/gnome metas.
##
## FORK-01 Step 5b note: this group's package list is the SOURCE of
## TRUTH for what gets shipped in /cdrom/pool to support the
## athena-tasksel-data fork's `gnome-desktop` task.  The fork at
## fork/source/athena-tasksel/tasks/gnome-desktop has a MIRROR of
## this list as its Key: field.  Keep them in sync when adding/
## removing packages (Path β workflow per docs/plans/fork-source.md).
# Basic GNOME — login screen, desktop shell, file manager, terminal,
# settings UI, browser, common GNOME utilities.  Deliberately omits
# games, office suites, music/photo apps; operator can apt-install
# those individually post-install if desired.  Closure is large —
# expect ~1-2 GB added to repo/ and a comparable source-build time
# (mutter, gjs, webkit2gtk pull in via gnome-shell's Depends).
#
# Display server / compositor lives inside gnome-shell's deps
# (mutter handles Wayland and X11 via xwayland).  gdm3 pulls in the
# greeter + xserver-xorg fallback automatically.  network-manager-
# gnome is the only non-GNOME-named explicit seed; needed for the
# shell's network applet to find NetworkManager.

# Desktop + display manager
gnome-shell
gdm3

# X.org server drivers — `xserver-xorg` (pulled by gdm3 transitively)
# has alt-deps `xserver-xorg-video-all | xorg-driver-video` and
# `xserver-xorg-input-all | xorg-driver-input`.  Neither alternative
# resolves automatically because the virtual `xorg-driver-*` names are
# Provides from individual driver packages — none of which are in
# our closure unless seeded explicitly.  The `*-all` meta-packages
# pull every driver Debian ships (amdgpu, ati, intel, nouveau, fbdev,
# vesa, qxl, vmware, libinput, …).  Heavy-handed but covers any
# target hardware; prune to a hardware-targeted subset later if ISO
# size matters.
xserver-xorg-video-all
xserver-xorg-input-all

# Core GNOME apps
gnome-terminal
nautilus
gnome-control-center
gnome-text-editor
gnome-system-monitor
gnome-screenshot
gnome-disk-utility
gnome-calculator
eog
evince

# Browser
firefox-esr

# Network manager (frontend for the shell's network applet)
network-manager-gnome

# Fonts — Noto is GNOME's preferred sans/serif/mono; DejaVu fills
# Latin-script gaps that Noto-core doesn't cover.
fonts-noto-core
fonts-dejavu-core

# ─── FORK-01 Step 5 follow-up (2026-05-17): merge with Debian's
# gnome-desktop task content ─────────────────────────────────────────
# Per the audit (debian-tasks.desc gnome-desktop = gnome-core +
# Recommends gnome), we picked the missing-from-our-seeds packages
# across categories A, B, C (PIM+Software only), and E.
# Skipped: D (LibreOffice — TODO file separately), F (Debian
# branding — TODO Athena branding pkg), G (a11y/specialty), H (the
# gnome/gnome-core metas themselves — picking explicit deps for
# honest dpkg metadata).

# A: GNOME core infrastructure — session, settings daemon, keyring,
# audio stack (pipewire), portals, gvfs, gstreamer base+good plugins,
# theming.
gnome-session
gnome-settings-daemon
gnome-keyring
libpam-gnome-keyring
gnome-menus
gsettings-desktop-schemas
glib-networking
gnome-online-accounts
gvfs-backends
gvfs-fuse
libatk-adaptor
libcanberra-pulse
libglib2.0-bin
librsvg2-common
sound-theme-freedesktop
xdg-desktop-portal-gnome
pipewire-audio
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gnome-shell-extensions

# B: GNOME default apps & utilities that a GNOME desktop user
# expects out of box (file roller archives, disk usage, help
# viewer, tweaks UI, theme set, user-dir auto-creation).
file-roller
baobab
yelp
gnome-tweaks
gnome-themes-extra
gnome-user-docs
gnome-logs
xdg-user-dirs-gtk

# C: GNOME PIM + Software Center (calendar/contacts/clocks +
# gnome-software for graphical app installs).  Per user
# 2026-05-17 — keep this subset of the broader "extras", skip
# rhythmbox/totem/maps/weather/photo apps for now.
gnome-calendar
gnome-contacts
gnome-clocks
gnome-software

# E: System administration GUI tools.
synaptic
system-config-printer-common
system-config-printer-udev
