# pkg.list — INI-style.  Each `[group]` section is an install-time
# package group.  `[base]` is always installed (live image + target
# debootstrap); other groups ship in /cdrom/pool and the installer
# (tasksel) apt-installs the operator-selected subset on /target.
#
# Backward-compat: a flat pkg.list (no `[section]` markers) is parsed
# as a single implicit `[base]` group.

[base]
## Description: Athena base system — kernel, bootloader, init, shell.
# Linux kernel
linux-image-amd64
# Kernel headers — needed only by DKMS / out-of-tree module compiles.
# Not required for a vanilla running system; kept for developer/admin
# convenience.
linux-headers-amd64
# Free firmware blobs the kernel recommends.  Covers BSD-licensed
# firmware for various NICs, GPUs, and storage controllers.  No
# non-free-firmware component needed.  For non-free firmware blobs
# (firmware-iwlwifi, firmware-misc-nonfree) or CPU microcode
# (intel-microcode, amd64-microcode), add 'non-free-firmware' to
# the [Mirror.*] Component lines in build.conf — separate work.
firmware-linux-free

# Bootloader
#
# Ship the bin-only packages for both BIOS (`grub-pc-bin`) and EFI
# (`grub-efi-amd64-bin`) modes.  Unlike the full `grub-pc` /
# `grub-efi-amd64` meta-packages, the `-bin` packages do NOT Conflict,
# so both can coexist on the live/installer system and on /target.
#
# At install time, `grub-installer` detects the firmware mode (BIOS vs
# EFI) and runs `apt-install grub-pc` or `apt-install grub-efi-amd64`.
# The chosen meta-package Depends on its corresponding `-bin`, which
# is already present in /target (debootstrap pulled it in via
# .disk/base_include), so apt only has to install the small meta and
# its EFI/BIOS-specific glue.  No network fetch of grub itself.
#
# History: COMP-02 phase A pre-installed the full `grub-pc` here as a
# workaround for a broken apt-cdrom-setup chain — `grub-installer`'s
# `apt-install grub-pc` step would fail on the in-target apt sources,
# exit 10, corrupt main-menu's debconf DB, and trigger a respawn loop.
# Phase C (commit 42e03ea) fixed apt-cdrom-setup end-to-end by signing
# the Release file and installing the pubkey at /target before the
# apt-cdrom step runs, so the workaround is no longer needed.  Switching
# to bin-only also unblocks EFI installs (Phase D, this change).
grub-pc-bin
grub-efi-amd64-bin

# Essential Packages
base-files
base-passwd
libc6
zlib1g
init
adduser
apt
debian-archive-keyring
debconf
e2fsprogs
findutils
grep
gzip
kbd
locales
login
mount
ncurses-base
sed
tar
tzdata
udev
util-linux
gawk

# Init System
systemd-sysv
libsystemd0
libpam-systemd

bash
bsdutils
coreutils
debianutils
diffutils
dpkg
hostname
init-system-helpers
libc-bin
ncurses-bin
perl-base
sysvinit-utils

initramfs-tools

# Remote access
openssh-server

# required for login
dbus

# simplifying package selection
dialog

# d-i runtime apt-install dependencies — packages that base-installer,
# grub-installer, hw-detect, finish-install, etc. call `apt-install`
# on at install time.  Listing them explicitly here puts them in
# pkg_closure (Pass III) so they're definitely on the target AND not
# accidentally classified as `live_exclusive` (which happens when
# live.list's transitive deps happen to mention them first — caught
# 2026-05-12 with busybox).  See audit in conversation 2026-05-12
# (apt-install callsite walk through buildroot/installer/).

# FATAL apt-installs — d-i scripts abort if these aren't on target.
# busybox, zstd: base-installer/library.sh kernel install path
# grub-common, dmsetup: grub-installer
busybox
zstd
grub-common
dmsetup

# TOLERANT (|| true) but their absence shows up as warnings/cosmetic
# issues at finish-install or in main-menu.  Adding them silences
# `eject: not found`, `Falling back to package description for
# os-prober-udeb`, and the queued-but-no-source warnings from
# cdrom-detect / hw-detect for pciutils + usbutils.
eject
os-prober
pciutils
usbutils

# Filesystems other than ext4 — partman finish queues these via
# apt-install when the user picks the corresponding fs.  dosfstools is
# needed for the EFI System Partition (vfat); pre-installing means
# COMP-02 phase D (EFI support) doesn't need a separate add.
dosfstools

# sudo is already a Recommends of several packages so it'd come in
# via extras; explicit here so it's in base_include (the target's
# install set) — gives a usable default for `user-setup-apply` to wire
# up admin sudo without depending on apt-install succeeding mid-install.
sudo

# tasksel — the "Software selection" engine pkgsel calls during
# install.  Goes in [base] (debootstrapped onto every /target) so
# pkgsel's `in-target tasksel --new-install` works offline from
# /cdrom/pool without an apt-install step.  Reads operator-defined
# tasks from /target/usr/share/tasksel/descs/athena.desc, which the
# pre-pkgsel.d-athena-tasks hook (in the initrd) copies from
# /cdrom/.disk/athena-tasks.desc.  See GROUPS-01 phase 2.
tasksel
