# Packages required exclusively for the debian-installer (d-i) ISO —
# over and above pkg.list.
#
# Mixed-universe list: each name is dispatched per which hashtable
# carries it.  udeb names → udeb_dep_tree closure (installer ramdisk).
# deb names → deb dep tree's installer_exclusive set (pool extras
# the installer apt-pulls onto the target at install time).  Both →
# both.  Resolver warns on names in neither index.

# ─── Cdebconf frontend ─────────────────────────────────────────────
# cdebconf-udeb is the engine — pulled transitively by base-installer's
# closure.  But the engine needs a frontend PLUGIN to render prompts;
# without one, cdebconf's debconf.c:241 main() loops "Cannot initialize
# debconf frontend".  cdebconf-udeb's baked-in /etc/cdebconf.conf says
# driver="newt", so we need cdebconf-newt-udeb in the chroot.
cdebconf-newt-udeb

# ─── Orchestrator + ramdisk core ───────────────────────────────────
# main-menu sequences install steps by walking dpkg status for udebs
# carrying Installer-Menu-Item: NNNN.  Without it there's no install
# flow at all.
main-menu
# rootskel ships /sbin/init + the S20/S60/S70 run-parts scripts that
# bootstrap cdebconf and exec main-menu.
rootskel
# udpkg is the d-i package handler used by main-menu to invoke each
# step udeb's postinst as the step (`udpkg --configure <pkg>`).
udpkg
# busybox-udeb provides the shell + utils used by the init scripts.
busybox-udeb

# ─── Partitioning chain ────────────────────────────────────────────
# partman-base is the partitioning framework + UI; the other partman-*
# udebs plug in filesystem support + recipe steps.  Per the locked
# decision (whole-disk ESP + ext4 + no swap, UEFI+BIOS), we
# need: base + auto (guided recipe) + target (mounter) + ext3 (ext4
# is handled by the same udeb) + efi (ESP) + basicfilesystems (FAT
# for the ESP).
partman-base
partman-auto
partman-target
partman-ext3
partman-efi
partman-basicfilesystems

# ─── Install workflow steps ────────────────────────────────────────
# base-installer is in required → already pulled.  apt-setup-udeb
# writes the target's /etc/apt/sources.list at install time; user-setup-
# udeb creates the first user account; grub-installer runs grub-install
# on the target.
apt-setup-udeb
user-setup-udeb
grub-installer

# ─── Disc-eject helper ─────────────────────────────────────────────
# eject-udeb provides /bin/eject inside the installer ramdisk so
# finish-install.d/15cdrom-detect can eject /dev/sr0 at the end of
# install.  The `eject` deb is on the target system (via pkg.list)
# but the installer chroot needs this udeb separately.  Caught
# 2026-05-12 — install completes cleanly but the disc doesn't
# auto-eject and `eject: not found` shows in the syslog.
eject-udeb

# ─── Hardware + media detection ────────────────────────────────────
# hw-detect modprobes drivers for storage/network etc. at boot.
# disk-detect feeds partman with the available block devices.
# cdrom-detect locates the install media; mountmedia actually mounts
# it at /cdrom; cdrom-retriever pulls files out of /cdrom for
# base-installer's pool reads.  All three needed for our file:///cdrom
# install path (the locked decision).
#
# DO NOT add iso-scan here.  iso-scan and cdrom-detect both have
# Installer-Menu-Item: 1300 AND iso-scan declares Provides: cdrom-detect.
# When both are installed, main-menu picks iso-scan as the "provider"
# of cdrom-detect and the real cdrom-detect never runs — iso-scan then
# fails ("Failed to find an installer ISO image") because it's looking
# for an ISO image *file* on a block device, not for the boot CD itself.
# Caught 2026-05-11 in a VMware install.
#
# To support USB-stick-with-ISO-file install later: ship a separate
# installer.list variant (or build flavor) that has iso-scan INSTEAD
# OF cdrom-detect.  Don't ship both.
hw-detect
disk-detect
cdrom-detect
mountmedia
cdrom-retriever

# ─── Preseed runtime ───────────────────────────────────────────────
# preseed-common loads /preseed.cfg (baked into the initrd by Phase 5's
# overlay) and pre-answers debconf questions per its contents.  v1
# preseed.cfg is empty so this is benign but cheap to include.
preseed-common

# ─── Installer environment polish ──────────────────────────────────
# installation-locale sets up LANG/LC_* in the installer's env so
# cdebconf prompts render UTF-8 correctly.  cdebconf-priority lets the
# operator filter low/medium/high/critical questions — defaulted to
# high, the standard d-i behaviour.  Both small, both pulled in
# essentially every real installer build.
installation-locale
cdebconf-priority

# ─── Kernel module udebs (storage / CD / USB detection) ────────────
# Listed by VIRTUAL name (each ABI's *-modules-X-amd64-di udeb
# Provides: the virtual name).  Auto-pick-highest-when-ambiguous (the
# udeb-tree DependencyTree flag) picks the latest kernel ABI — keeps
# installer.list ABI-independent.  Without these, hw-detect can't
# modprobe the drivers needed for /dev/sr0 (CD) or /dev/sd* (USB) to
# appear, and cdrom-detect reports "No device or installation media
# (like CD-ROM) was detected".
#
# Naming gotcha: `scsi-core-modules` is just the SCSI plumbing (sd_mod,
# scsi_mod, sg).  The actual HOST CONTROLLER drivers (mpt3sas, vmw_pvscsi,
# BusLogic, virtio_blk, nvme, megaraid, hv_storvsc, xen-blkfront, etc.)
# live in a SEPARATE udeb called `scsi-modules`.  Caught 2026-05-11 when
# installer booted in a VMware VM, couldn't see /dev/sda or /dev/sr0,
# and fell through to iso-scan's "no device" dialog.
#
#   cdrom-core-modules  — sr_mod + cdrom.ko (the actual CD driver)
#   scsi-core-modules   — sd_mod + scsi_mod + scsi_transport_* (plumbing)
#   scsi-modules        — actual HBA drivers: mpt3sas, vmw_pvscsi,
#                         BusLogic, virtio_blk/scsi, nvme, megaraid,
#                         hv_storvsc, xen-blkfront, qla*, aic*, lpfc,
#                         and ~80 other host controllers
#   ata-modules         — libata + ata_generic (framework)
#   sata-modules        — ahci, ata_piix, sata_* (SATA-specific)
#   usb-modules         — USB controllers (xhci, ehci, uhci, ohci)
#   usb-storage-modules — USB mass storage (USB-CD, USB-stick install)
#   isofs-modules       — isofs.ko (ISO9660 filesystem).  Without this
#                         the kernel CANNOT mount any CDROM — cdrom-detect
#                         finds /dev/sr0 but the mount fails.
cdrom-core-modules
scsi-core-modules
scsi-modules
ata-modules
sata-modules
usb-modules
usb-storage-modules
isofs-modules

# ─── Stock d-i seed: pkg-lists/base ────────────────────────────────
# Verbatim from debian-installer 20230607+deb12u13 pkg-lists/base.  These
# are the udebs stock d-i puts in EVERY image flavour (cdrom, netboot,
# hd-media, etc.) — the "minimum installer" set.  Most are pulled
# transitively by main-menu/rootskel/anna anyway, but seeding them
# explicitly hardens us against upstream Recommends/Depends churn and
# makes our installer.list a strict superset of stock's base.
# Caught 2026-05-12 during stock-seed audit: even udebs we never expect
# to need on a cdrom flavour (e.g. wget-udeb is netboot-shaped) are kept
# because they may matter on other targets we add later (USB, PXE).
anna
archdetect
cdebconf-udeb
di-utils
di-utils-reboot
di-utils-shell
libdebconfclient0-udeb
libdebian-installer4-udeb
lowmemcheck
rescue-check
env-preseed
pciutils-udeb
screen-udeb
wget-udeb
ca-certificates-udeb
kmod-udeb
haveged-udeb
wireless-regdb-udeb
udev-udeb

# ─── Stock d-i seed: pkg-lists/cdrom/common ────────────────────────
# Verbatim from pkg-lists/cdrom/common — cdrom-flavour additions on top
# of base.  Localechooser (language picker on first menu), load-cdrom
# (loads the cdrom-detect/cdrom-retriever pair which we already seed
# explicitly above), cdrom-checker (md5sum verification of the disc),
# bogl-bterm-udeb + di-utils-terminfo (bterm renderer for non-Latin
# scripts), cdebconf-newt-terminal (newt frontend's terminal handling),
# cdebconf-text-udeb (text frontend for serial consoles — our build
# host already uses it via console=ttyS0), brltty-udeb (braille support
# for accessibility), initrd-preseed + file-preseed (preseed loaders —
# we currently only use file-preseed for /preseed.cfg but seeding both
# makes our installer accept network/initrd preseeds in future
# flavours), nano-udeb (rescue editor), media-retriever (generic media
# retrieval — paired with cdrom-retriever for hd-media flavours),
# save-logs (operator can ALT+F4 → save-logs to dump /var/log/installer
# to USB/floppy at any point), libfribidi0-udeb (bidi text for RTL
# locales).
localechooser
load-cdrom
cdrom-checker
bogl-bterm-udeb
di-utils-terminfo
cdebconf-newt-terminal
cdebconf-text-udeb
brltty-udeb
initrd-preseed
file-preseed
nano-udeb
media-retriever
save-logs
libfribidi0-udeb

# ─── Stock d-i seed: pkg-lists/cdrom/amd64.cfg + cd_drivers ────────
# Verbatim from pkg-lists/cdrom/amd64.cfg.  console-setup-pc-ekmap is
# the PC keyboard layout map (US/UK/DE/etc. — needed for the keyboard
# step in main-menu), console-setup-udeb is the runtime keymap loader,
# kbd-udeb provides /usr/bin/loadkeys.  The *-modules entries are
# kernel-driver bundles listed by VIRTUAL name (per-ABI udebs Provides:
# the virtual name; auto-pick-highest selects the latest kernel ABI in
# the dep tree).  Without these, hw-detect can't probe a working
# subset of hardware; on amd64 in particular fat-modules is needed to
# mount the ESP at install time (partman-efi formats it).
#
# Note: stock's pkg-lists/cdrom/amd64.cfg names scsi-common-modules but
# bookworm's kernel-udeb packaging split that into scsi-core-modules
# (plumbing) + scsi-modules (HBAs); both are already seeded above under
# the existing "Kernel module udebs" section so scsi-common-modules is
# implicitly covered.
console-setup-pc-ekmap
console-setup-udeb
kbd-udeb
fat-modules
input-modules
fb-modules
serial-modules
usb-serial-modules
uinput-modules
firewire-core-modules
mmc-modules
acpi-modules

# ─── Software selection (Phase 2 of GROUPS-01) ─────────────────────
# pkgsel drives d-i's "Software selection" step at install time.  It
# calls `in-target tasksel --new-install` so the operator picks
# pkg.list groups via tasksel's UI.  Without pkgsel in the installer
# ramdisk, the tasksel step is silently skipped and groups are
# unreachable.
#
# FORK-01 Step 5: athena-pkgsel (Provides + Conflicts + Replaces
# pkgsel) — Athena fork from fork/source/athena-pkgsel/ that drops
# the DEBIAN_TASKS_ONLY=1 env prefix on the tasksel call.  Pairs
# with athena-tasksel (in pkg.list base) which ignores the env var
# at the engine level too.
athena-pkgsel

# ─── Target-side debs (NOT udebs — for the apt pool) ───────────────
# These are deb names that grub-installer apt-pulls onto the TARGET at
# install time.  Listed here defensively so they stay in the pool even
# if live.list ever drops them.  Already in live.list under the locked
# decision.
efibootmgr
grub-pc-bin

# ─── Athena fork packages (FORK-01) ────────────────────────────────
# athena-installer-data ships installer-side stub templates + (future)
# release identity files + (future) tasksel wrapper.  Built from
# fork/source/athena-installer-data/; appears as a udeb via the fork
# mirror Cache ingests at build time.  See fork/source/README.md and
# docs/plans/fork-source.md.
athena-installer-data
