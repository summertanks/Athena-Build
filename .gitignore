# Python virtual environment
.venv/
venv/
env/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo

# Build output directories (generated at runtime) — leading `/` scopes
# the match to the repo root, so they don't accidentally swallow
# matching subdirs inside the source tree (e.g. fork/source/<pkg>/packages/
# is a legitimate part of an upstream-derived fork).
/buildroot/
/cache/
/coord/
/download/
/gnupg/
/image/
/localmirror/
/log/
/packages/
/publish/
/repo/
/source/
/tmp/

# Secrets — private keys must never be committed (e.g. the rsync/SSH
# publish key referenced by [Repo] PublishSshKey).
config/*.key
*.pem

# Per-checkout snapshot pins (base + current) — operational state set via
# `snapshot select`, not shared.  A fresh checkout has none and is prompted
# to select both on the first `cache build` (UPD-01).  snapshot.history is the
# per-checkout append-log of selections — same operational category.
config/snapshot.state
config/snapshot.history

# Machine-local onboarding sidecar — build Mode, system Role, SetupComplete,
# builder Name, host build tuning ([Build] MaxParallelBuilds/BuildCpus/
# BuildMemory/DOCKER_SERVER), signing identity ([Repo] SigningKeyUid) and
# per-mirror registration markers.  Per-machine, never shared; a fresh
# `git pull` must not inherit another box's mode, tuning, or identity.
config/local.conf

# Machine-local registry of remote build hosts ([Remote.<name>]: ssh ship-to
# target + that host's build tuning).  Created by `container remote add`.
# Per-machine endpoints + access — never shared.
config/remote.conf

# Per-machine federation mirror state — ALL mirrors in one HMAC-signed
# config/mirror.conf (url, ssh-key name, public_url, snapshot pins; tamper-
# evident).  config/mirror.<name>.state is the legacy per-mirror layout,
# auto-migrated into mirror.conf on first read.  Untracked: tracking these
# would leak one machine's mirror identity into the repo for everyone.
config/mirror.conf
config/mirror.*.state

# Per-checkout signed published-manifest (mirror of what's published; the
# +asg bump authority).  Regenerated on publish; not shared (UPD-01).
config/published.manifest
config/published.manifest.sig

# IDE
.idea/
.vscode/
*.iml

# fork/ mirror metadata — generated by scripts/fork_mirror.py at
# cache-build time.  Operator never edits these; they're rebuilt
# every cache load from fork/source/<pkg>/debian/.
fork/Release
fork/Packages
fork/Packages.gz
fork/Packages-udeb
fork/Packages-udeb.gz
fork/Sources
fork/Sources.gz

# fork/source/repo/ — dpkg-source -b output (helper-generated source pkgs)
fork/source/repo/

# fork/source/ — dpkg-buildpackage artifacts land in PARENT of each
# package's source tree (i.e. directly under fork/source/), and per-
# pkg debian/ scratch land inside debian/.  Source trees themselves
# (fork/source/<pkg>/debian/, fork/source/<pkg>/data/) are tracked.
fork/source/*.udeb
fork/source/*.deb
fork/source/*.changes
fork/source/*.buildinfo
fork/source/*.dsc
fork/source/*.tar.gz
fork/source/*.tar.xz
fork/source/*.tar.bz2
fork/source/*/debian/.debhelper/
fork/source/*/debian/files
fork/source/*/debian/tmp/
fork/source/*/debian/*.substvars
fork/source/*/debian/*.debhelper.log
fork/source/*/debian/debhelper-build-stamp
# Per-binary unpack dirs created by dh: e.g. fork/source/foo/debian/foo/
# Matched by walking known package names — simpler to exclude debian/<name>/
# only when running locally; gitignore can't easily express "match dir whose
# name equals the parent's name", so rely on dh_clean to wipe these between
# builds.

# machine-local HMAC-signed selection sidecar (per-builder; never commit)
config/selection.state

# Generated frozen toolchain version stamp (scripts/freeze via bump_version --freeze-stamp)
scripts/_buildstamp.py
